		{ "bar": 1, "beat": 1, "y": 5, "type": "MoveRow", "row": 0, "target": "WholeRow", "customPosition": true, "rowPosition": [-5, 40], "duration": 0, "ease": "Linear" },
		{ "bar": 1, "beat": 2, "y": 0, "type": "ShowDialogue", "if": "4d0", "rooms": [4], "text": "[[ink:diaTutorialAthleteFinale,\nIntro1,\nImmediately]]", "speed": 1, "panelSide": "Bottom", "portraitSide": "Left", "playTextSounds": true },
		{ "bar": 1, "beat": 3, "y": 1, "type": "Comment", "tab": "Actions", "text": "<-- Don't forget to add \"dia\" before the sheet name when replacing [[ink:this]] prototyping with proper knots from Ink", "color": "F2E644", "show": true },
		{ "bar": 1, "beat": 3, "y": 0, "type": "Comment", "tab": "Actions", "text": "Everything after [[ink:this]] should be copied to the Ink spreadsheet, each dialogue event to its own knot.", "color": "F2E644", "show": true },
		{ "bar": 1, "beat": 4, "y": 3, "type": "Comment", "tab": "Actions", "text": "\"rowEnter\"\nFarmer entrance animation, trigger in dialogue", "color": "F2E644", "show": false },
		{ "bar": 2, "y": 1, "type": "SetCrotchetsPerBar", "crotchetsPerBar": 2, "visualBeatMultiplier": 1 },
		{ "bar": 2, "beat": 1, "y": 4, "type": "MoveRow", "tag": "rowEnter", "row": 0, "target": "WholeRow", "customPosition": true, "rowPosition": [null, 50], "duration": 2, "ease": "OutQuint" },
		{ "bar": 2, "beat": 1, "y": 5, "type": "HideRow", "if": "4d0", "tag": "rowEnter", "row": 0, "show": "OnlyCharacter", "transition": "Smooth" },
		{ "bar": 2, "beat": 1, "y": 3, "type": "MoveRow", "tag": "rowEnter", "row": 0, "target": "WholeRow", "customPosition": true, "rowPosition": [10, null], "duration": 2, "ease": "OutQuart" },
		{ "bar": 2, "beat": 2, "y": 0, "type": "PlaySound", "sound": {"filename": "sndTutorialSynthPrelude"}, "customSoundType": "MusicSound" },
		{ "bar": 3, "y": 0, "type": "PlaySong", "song": {"filename": "sndTutorialSynth"}, "bpm": 88, "loop": false },
		{ "bar": 3, "beat": 1, "y": 0, "type": "ShowDialogue", "if": "4d0", "rooms": [4], "text": "[[ink:diaTutorialAthleteFinale,\nIntro2,\nOnNextBar]]", "speed": 1, "panelSide": "Bottom", "portraitSide": "Left", "playTextSounds": true },
		{ "bar": 3, "beat": 1, "y": 3, "type": "Comment", "tab": "Actions", "text": "\"dialogueStart\"\nTrigger at start of active dialogues:\n1. Slows down background scroll speed\n2. Hides ECG line (optional)", "color": "F2E644", "show": false },
		{ "bar": 3, "y": 2, "type": "SetCrotchetsPerBar", "crotchetsPerBar": 8, "visualBeatMultiplier": 1 },
		{ "bar": 3, "beat": 2, "y": 3, "type": "SetVFXPreset", "tag": "dialogueStart", "rooms": [0], "preset": "Tutorial", "enable": true, "intensity": 100, "color": "pal5", "duration": 1.75, "ease": "OutSine" },
		{ "bar": 3, "beat": 2, "y": 0, "type": "Comment", "tab": "Actions", "text": "Active dialogues (1/3)\nPrototyping syntax is\n[[ink:this, Freeze, Unfreeze]]\nProduction syntax is\n[[ink:diaSheetName, KnotName, Freeze, Unfreeze]]", "color": "F2E644", "show": false },
		{ "bar": 3, "beat": 2, "y": 4, "type": "HideRow", "if": "4d0", "tag": "dialogueStart", "row": 0, "show": "OnlyCharacter", "transition": "Smooth" },
		{ "bar": 3, "beat": 3, "y": 0, "type": "Comment", "tab": "Actions", "text": "Active dialogues (2/3)\nIf you leave freeze behaviour empty, it defaults to \"Prolong\", which is usually what we want anyways. So basically you only ever need to specify the unfreeze behaviour", "color": "F2E644", "show": false },
		{ "bar": 3, "beat": 4, "y": 0, "type": "Comment", "tab": "Actions", "text": "Active dialogues (3/3)\nUse either \"OnNextBar\" (the default), or \"Immediately\" (used in first dialogue to start music, and in last dialogue to end tutorial). ", "color": "F2E644", "show": false },
		{ "bar": 4, "beat": 1, "y": 3, "type": "Comment", "tab": "Actions", "text": "\"doctorOnline\"\nCan ignore if tutorial doesn't require CPU demonstration.\nDon't forget the corresponding event in Sounds!", "color": "BB0000", "show": false },
		{ "bar": 4, "beat": 1, "y": 2, "type": "Comment", "tab": "Actions", "text": "If no CPU demonstration is needed\n- Delete bars 4-7\n- Don't use the doctor online/offline tags in dialogue", "color": "F2E644", "show": false },
		{ "bar": 4, "beat": 1, "y": 3, "type": "Comment", "tab": "Song", "text": "\"doctorOnline\" tag\n\nCan ignore if tutorial doesn't require CPU demonstration.\nDon't forget the corresponding events in Actions!", "color": "A349A4", "show": false },
		{ "bar": 4, "beat": 1, "y": 0, "type": "ShowDialogue", "if": "4d0", "rooms": [4], "text": "[[ink:diaTutorialAthleteFinale,\nDemonstrationStart]]", "speed": 1, "panelSide": "Bottom", "portraitSide": "Left", "playTextSounds": true },
