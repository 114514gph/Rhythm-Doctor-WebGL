		{ "bar": 1, "beat": 3, "y": 1, "type": "Comment", "tab": "Actions", "text": "<-- Don't forget to add \"dia\" before the sheet name when replacing [[ink:this]] prototyping with proper knots from Ink", "color": "F2E644", "show": false },
		{ "bar": 1, "beat": 3, "y": 0, "type": "Comment", "tab": "Actions", "text": "Everything after [[ink:this]] should be copied to the Ink spreadsheet, each dialogue event to its own knot.", "color": "F2E644", "show": false },
