		{ "bar": 2, "beat": 2, "y": 1, "type": "Comment", "tab": "Actions", "text": "Active dialogues (1/3)\nPrototyping syntax is\n[[ink:this, Freeze, Unfreeze]]\nProduction syntax is\n[[ink:diaSheetName, KnotName, Freeze, Unfreeze]]", "color": "F2E644", "show": false },
