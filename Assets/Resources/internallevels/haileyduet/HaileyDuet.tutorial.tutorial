		{ "bar": 2, "beat": 4, "y": 1, "type": "Comment", "tab": "Actions", "text": "Active dialogues (3/3)\nUse either \"OnNextBar\" (the default), or \"Immediately\" (used in first dialogue to start music, and in last dialogue to end tutorial). ", "color": "F2E644", "show": false },
